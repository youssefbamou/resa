# Copiez ce fichier : cp .env.example .env
# Valeurs de développement local uniquement : jamais de vrai secret ici.

# Port de l'application sur votre machine
PORT=3000

# PostgreSQL (service "db" de docker-compose.yml)
POSTGRES_USER=resa
POSTGRES_PASSWORD=change-me-local
POSTGRES_DB=resa
# Port de la base sur votre machine (publié sur 127.0.0.1 uniquement)
PGPORT=5433

# Utilisé seulement si vous lancez l'app hors Docker (npm run dev).
# Dans Docker, docker-compose.yml construit cette URL lui-même.
DATABASE_URL=postgres://resa:change-me-local@127.0.0.1:5433/resa
